# ========================
# AI Interview - Backend 환경 설정
# ========================

# 서버
APP_NAME="AI 면접 도우미"
APP_VERSION="0.1.0"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 보안
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# DB
DATABASE_URL=sqlite+aiosqlite:///./interview.db

# CORS (프론트엔드 주소)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 파일 저장
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100


# 이메일 (비밀번호 재설정)
# Gmail 사용 시: 구글 계정 → 보안 → 앱 비밀번호 생성 후 아래에 입력
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
FRONTEND_URL=http://localhost:5173

# ---- AI 모델 설정 ----
# KoBERT (현재 비활성화 상태)
KOBERT_MODEL_PATH=./models/kobert
# KOBERT_MAX_LENGTH=512

# Gemini — 점수 산정용으로 당분간 계속 사용
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Llama — 파인튜닝된 로컬 모델 (답변 피드백 텍스트 / 질문 생성)
LLAMA_BASE_MODEL=meta-llama/Llama-3.2-3B-Instruct
LLAMA_ADAPTER_PATH=./ai_models/llama-interview-adapter
LLAMA_USE_4BIT=False
LLAMA_MAX_NEW_TOKENS=512

# Whisper
# WHISPER_MODEL_SIZE=base
# WHISPER_LANGUAGE=ko

# MediaPipe
# MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
