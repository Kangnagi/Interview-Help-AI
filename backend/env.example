# ========================
# AI Interview - Backend 환경 설정
# ========================

# 서버
APP_NAME="내일의 면접"
APP_VERSION="0.1.0"
# DEBUG=true  : 로컬 개발용. /docs·/redoc 노출, 코드 변경 시 자동 재시작, 상세 로그
# DEBUG=false : 운영 배포용. API 문서 비활성화, SECRET_KEY가 약하면 서버가 아예 기동을 거부함
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 보안
# 운영(DEBUG=false) 전환 전 반드시 아래 명령으로 새로 생성해서 교체할 것:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 사용 중이면 화면이 만료 전에 로그인을 자동 연장한다. 그래도 로그인 후 이 시간(시간 단위)이 지나면 다시 로그인
SESSION_MAX_HOURS=24

# Rate Limiting (slowapi) — IP당 제한
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
GLOBAL_RATE_LIMIT=100/minute

# 계정 잠금 — 로그인 연속 실패 시
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15

# 요청 본문 크기 제한
MAX_REQUEST_SIZE_MB=10
MAX_UPLOAD_REQUEST_SIZE_MB=200

# DB
DATABASE_URL=sqlite+aiosqlite:///./interview.db

# CORS (프론트엔드 주소, 콤마로 구분)
# 로컬 개발 주소 + 실제 배포 도메인을 함께 등록
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://www.your-domain.com,https://your-domain.com

# 파일 저장
UPLOAD_DIR=./uploads


# 이메일 (비밀번호 재설정)
# Gmail 사용 시: 구글 계정 → 보안 → 앱 비밀번호 생성 후 아래에 입력
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
# 비밀번호 재설정 이메일 링크에 사용 — 배포 시 실제 도메인으로 변경
FRONTEND_URL=https://www.your-domain.com

# ---- 관리자 ----
# 관리자 검토 화면(/admin/review)을 쓸 계정 이메일 (콤마로 여러 개)
ADMIN_EMAILS=

# ---- AI 모델 설정 ----
# Gemini — 서비스 동작 경로에서는 더 이상 사용하지 않음 (비워 두거나 지워도 됨)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# 로컬 모델 — Bllossom-3B(한국어 Llama) 하나로 답변 채점 · 질문 생성 · 종합 총평
LLAMA_BASE_MODEL=Bllossom/llama-3.2-Korean-Bllossom-3B
LLAMA_ADAPTER_PATH=
LLAMA_SCORE_ADAPTER_PATH=./ai_models/bllossom-score-adapter-b3
# 되돌리기: LLAMA_SCORE_ADAPTER_PATH=./ai_models/bllossom-score-adapter-b2 (또는 -b1)
# 질문 전용 어댑터 (선택) — 비워 두면 질문은 키워드 + 질문 틀 방식. 켜기: ./ai_models/bllossom-qgen-q2
LLAMA_QGEN_ADAPTER_PATH=
LLAMA_USE_4BIT=False
LLAMA_MAX_NEW_TOKENS=512
# 질문 생성 · 총평을 다른 모델에 따로 맡길 때만 (GPU 약 6GB 추가). 비우면 위 기본 모델이 맡는다
TEXT_MODEL=
# 예전 구성(Llama-3.2-3B + a1)으로 되돌리기:
#   LLAMA_BASE_MODEL=meta-llama/Llama-3.2-3B-Instruct
#   LLAMA_ADAPTER_PATH=./ai_models/llama-interview-adapter
#   LLAMA_SCORE_ADAPTER_PATH=./ai_models/llama-score-adapter-a1
#   TEXT_MODEL=Bllossom/llama-3.2-Korean-Bllossom-3B
